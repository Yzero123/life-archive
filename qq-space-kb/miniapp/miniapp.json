{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/dashboard",
    "window": {
      "width": 1080,
      "height": 760,
      "minWidth": 480,
      "minHeight": 420,
      "resizable": true
    }
  },
  "mcpEndpoints": [],
  "agentAccess": [
    "session.run"
  ],
  "agentConcurrency": 4
}
